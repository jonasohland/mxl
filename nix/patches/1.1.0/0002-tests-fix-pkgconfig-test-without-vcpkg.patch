#
# Upstream commit c50eb408 on release/v1.1, after the v1.1.0 tag. Without it
# the pkg-config consumer test gets too few arguments in builds without vcpkg.

From c50eb4083c7685e547ff9dff286c5b4aca96815f Mon Sep 17 00:00:00 2001
From: "Jonas Ohland (Riedel)" <jonas.ohland@riedel.net>
Date: Fri, 6 Nov 2026 19:36:31 +0100
Subject: [PATCH] Fix pkgconfig-c-link test failing when building without vcpkg

Co-authored-by: Jonas Ohland <jonas.ohland@gmail.com>
Signed-off-by: Jonas Ohland (Riedel) <jonas.ohland@riedel.net>
(cherry picked from commit 672d1fefed9f75736202ce328218a80aedf58880)
---
 lib/tests/CMakeLists.txt           |  6 ++++--
 lib/tests/test_pkgconfig_c_link.sh | 10 +++++++---
 2 files changed, 11 insertions(+), 5 deletions(-)

diff --git a/lib/tests/CMakeLists.txt b/lib/tests/CMakeLists.txt
index 7867dc6c..49efa655 100644
--- a/lib/tests/CMakeLists.txt
+++ b/lib/tests/CMakeLists.txt
@@ -89,8 +89,10 @@ add_test(
   NAME "pkg-config C consumer can link and run"
   COMMAND ${CMAKE_CURRENT_SOURCE_DIR}/test_pkgconfig_c_link.sh
           ${CMAKE_BINARY_DIR}
-          ${VCPKG_INSTALLED_DIR}
-          ${VCPKG_TARGET_TRIPLET}
+          # Quoted so that empty values, as in builds without vcpkg, are still
+          # passed as arguments.
+          "${VCPKG_INSTALLED_DIR}"
+          "${VCPKG_TARGET_TRIPLET}"
           ${BUILD_SHARED_LIBS}
 	  ${MXL_ENABLE_FABRICS_OFI}
           MXL_LINKER_FLAG=${MXL_LINKER_FLAG}
diff --git a/lib/tests/test_pkgconfig_c_link.sh b/lib/tests/test_pkgconfig_c_link.sh
index dd13d39b..f9926c33 100755
--- a/lib/tests/test_pkgconfig_c_link.sh
+++ b/lib/tests/test_pkgconfig_c_link.sh
@@ -8,8 +8,8 @@ set -e
 usage() {
     echo "usage: $0 <build_dir> <vcpkg_install_dir> <vcpkg_triplet> <BUILD_SHARED_LIBS: ON|OFF> <MXL_ENABLE_FABRICS_OFI: ON|OFF> <MXL_LINKER_FLAG=<linker-selection-flag>> <c_compiler>" >&2
     echo "  build_dir         Path to the CMake build directory." >&2
-    echo "  vcpkg_install_dir vcpkg install directory" >&2
-    echo "  vcpkg_triplet     vcpkg target triplet used for the build." >&2
+    echo "  vcpkg_install_dir vcpkg install directory. Empty if the build does not use vcpkg." >&2
+    echo "  vcpkg_triplet     vcpkg target triplet used for the build. Empty if the build does not use vcpkg." >&2
     echo "  BUILD_SHARED_LIBS Indicates whether the build uses shared libraries (ON or OFF)." >&2
     echo "  MXL_ENABLE_FABRICS_OFI Enable libmxl-fabrics.pc test (ON or OFF)." >&2
     echo "  MXL_LINKER_FLAG   Optional compiler linker-selection flag (e.g. -fuse-ld=lld); empty means use default linker." >&2
@@ -39,7 +39,11 @@ case "$MXL_ENABLE_FABRICS_OFI" in
   *) usage; exit 2 ;;
 esac
 
-export PKG_CONFIG_PATH="$BUILD_DIR/pkgconfig_test:$VCPKG_INSTALL_DIR/$VCPKG_TRIPLET/lib/pkgconfig:${PKG_CONFIG_PATH}"
+VCPKG_PKG_CONFIG_PATH=""
+if [ -n "$VCPKG_INSTALL_DIR" ] && [ -n "$VCPKG_TRIPLET" ]; then
+    VCPKG_PKG_CONFIG_PATH="$VCPKG_INSTALL_DIR/$VCPKG_TRIPLET/lib/pkgconfig:"
+fi
+export PKG_CONFIG_PATH="$BUILD_DIR/pkgconfig_test:${VCPKG_PKG_CONFIG_PATH}${PKG_CONFIG_PATH}"
 
 case "$(uname -s)" in
   Linux)  DOMAIN_DIR="/dev/shm/mxl_link_test_domain" ;;
